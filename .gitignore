cat > .gitignore <<'EOF'
# Environment variables and secrets
.env
.env.*
!.env.example

# Python virtual environments
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/

# Database files
*.db
*.sqlite
*.sqlite3
*.db-journal

# Backup files
*backup*
old_databases/

# macOS
.DS_Store

# IDE
.vscode/
.idea/
EOFhackmate.bd
